{
  "name": "webportal-frontend",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/shared",
    "packages/web",
    "packages/mobile"
  ],
  "scripts": {
    "web:dev": "npm run dev -w packages/web",
    "web:build": "npm run build -w packages/web",
    "mobile:start": "npm run start -w packages/mobile",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "expo": "^56.0.20",
    "patch-package": "^8.0.1"
  },
  "overrides": {
    "expo-build-properties": "~56.0.26",
    "expo-modules-core": "~56.0.24",
    "expo-av": "^16.0.8"
  }
}
