{
  "expo": {
    "name": "OyemCore",
    "slug": "mobile",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.oyemsoft.oyemcore",
      "buildNumber": "60",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Demirbaş sayımında barkod/kod okutmak, taleplerinize belge/fotoğraf eklemek ve görüntülü görüşme yapmak için kamera kullanılır.",
        "NSMicrophoneUsageDescription": "Sohbet üzerinden görüntülü/sesli görüşme yapabilmek için mikrofon kullanılır.",
        "NSPhotoLibraryUsageDescription": "Taleplerinize belge veya fotoğraf eklemek için fotoğraf galerinize erişilir."
      },
      "bitcode": false
    },
    "android": {
      "package": "com.oyemsoft.oyemcore",
      "versionCode": 15,
      "googleServicesFile": "./google-services.json",
      "usesCleartextTraffic": false,
      "permissions": [
        "VIBRATE",
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.WAKE_LOCK",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.CAMERA",
        "android.permission.FOREGROUND_SERVICE_CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.BLUETOOTH"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "fc93a513-dc4a-4b7c-a9c4-b0ba29ef21b3"
      }
    },
    "plugins": [
      "expo-web-browser",
      [
        "@daily-co/config-plugin-rn-daily-js",
        {
          "enableScreenShare": false
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Demirbaş sayımında barkod/kod okutmak, taleplerinize belge/fotoğraf eklemek ve görüntülü görüşme yapmak için kamera kullanılır.",
          "microphonePermission": "Sohbet üzerinden görüntülü/sesli görüşme yapabilmek için mikrofon kullanılır."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "./plugins/withPodfilePostInstall",
      "expo-audio",
      [
        "expo-notifications",
        {
          "sounds": ["./assets/sounds/incoming_call.wav"]
        }
      ]
    ],
    "owner": "halilalp"
  }
}
