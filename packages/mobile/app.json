{
  "expo": {
    "name": "OyemCore",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.oyemsoft.oyemcore",
      "buildNumber": "1",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Demirbaş sayımında barkod/kod okutmak, taleplerinize belge/fotoğraf eklemek ve görüntülü görüşme yapmak için kamera kullanılır.",
        "NSMicrophoneUsageDescription": "Sohbet üzerinden görüntülü/sesli görüşme yapabilmek için mikrofon kullanılır.",
        "NSPhotoLibraryUsageDescription": "Taleplerinize belge veya fotoğraf eklemek için fotoğraf galerinize erişilir.",
        "UIBackgroundModes": [
          "voip",
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.oyemsoft.oyemcore",
      "versionCode": 2,
      "googleServicesFile": "./google-services.json",
      "usesCleartextTraffic": false,
      "permissions": [
        "VIBRATE",
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "34b84bb1-9215-4902-8c3d-137be6ef5766"
      }
    },
    "plugins": [
      "expo-web-browser",
      [
        "@daily-co/config-plugin-rn-daily-js",
        {
          "enableScreenShare": false
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Demirbaş sayımında barkod/kod okutmak, taleplerinize belge/fotoğraf eklemek ve görüntülü görüşme yapmak için kamera kullanılır.",
          "microphonePermission": "Sohbet üzerinden görüntülü/sesli görüşme yapabilmek için mikrofon kullanılır."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "./plugins/withPodfilePostInstall"
    ]
  }
}
